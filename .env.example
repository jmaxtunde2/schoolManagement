APP_NAME="Gestion des Notes"
APP_ENV=local
APP_KEY=
# En production : APP_DEBUG=false (ne jamais exposer les traces de pile).
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Africa/Porto-Novo
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En production (HTTPS), laisser la valeur par défaut : le cookie de session
# est alors automatiquement marqué « Secure ». Ne définir à true que si
# APP_ENV n'est pas « production ».
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# log pour le développement, emc, clicksend, esms_africa, multitexter ou whatsapp
SMS_PROVIDER=emc
SMS_API_URL=https://sms.esmsafrica.io
ESMS_TOKEN=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_SENDER_NAME=
# Indicatif par défaut (normalisation E.164 avant envoi WhatsApp)
SMS_COUNTRY_CODE=228

# Lien SMS sécurisé vers une évaluation (domaine public HTTPS)
SMS_ACCESS_URL="${APP_URL}"
SMS_ACCESS_TTL_HOURS=72
SMS_ACCESS_TOKEN_LENGTH=32
SMS_ACCESS_MAX_USES=25
SMS_ACCESS_MESSAGE="CoriSchool : une nouvelle évaluation de votre enfant est disponible. Voir les notes :"

# ClickSend (SMS_PROVIDER=clicksend) — https://dashboard.clicksend.com
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
# Laisser vide tant que le Sender ID n'est pas approuvé
CLICKSEND_SENDER_ID=
CLICKSEND_API_URL=https://rest.clicksend.com/v3

# e-MC (SMS_PROVIDER=emc) — https://api.e-mc.co/v3/
# Renseigner soit EMC_SMS_USERNAME + EMC_SMS_PASSWORD, soit EMC_SMS_API_KEY
# (clé Basic déjà encodée en base64). Ne jamais committer ces valeurs.
EMC_SMS_ENABLED=true
EMC_SMS_API_URL=https://api.e-mc.co/v3
EMC_SMS_API_KEY=
EMC_SMS_USERNAME=
EMC_SMS_PASSWORD=
EMC_SMS_SENDER=CoriSchool
EMC_SMS_TIMEOUT=15
# Indicatif utilisé par le provider e-MC pour les numéros locaux (Bénin).
EMC_SMS_COUNTRY_CODE=229
# Numéro utilisé par php artisan corischool:test-emc-sms sans argument.
EMC_SMS_TEST_TO=

# Fournisseur WhatsApp actif : meta | wati | twilio
WHATSAPP_PROVIDER=twilio

# Meta WhatsApp Business Cloud API (actif si WHATSAPP_PROVIDER=meta)
WHATSAPP_TOKEN=
META_WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_LATENESS_TEMPLATE_LANGUAGE=fr
# Accès parent : code valable 1 jour, un seul appareil actif à la fois.
PARENT_ACCESS_CODE_VALIDITY_MINUTES=1440
PARENT_ACCESS_MAX_DEVICES=1
# Canal d'envoi des codes : sms (défaut) ou whatsapp.
PARENT_ACCESS_CHANNEL=sms
PARENT_ACCESS_SMS_MESSAGE="CoriSchool : votre accès parent : {code}. Visitez votre espace ici : {url}."
PARENT_ACCESS_SMS_URL=https://corischool.com/ecole/{slug}
# Fournisseur WhatsApp dédié aux codes d'accès (twilio, wati, meta).
# Utilisé uniquement si PARENT_ACCESS_CHANNEL=whatsapp.
# Vide = fournisseur WhatsApp global (WHATSAPP_PROVIDER).
PARENT_ACCESS_WHATSAPP_PROVIDER=twilio
# Langue des modèles « verification_code_parent » et « espace_parent ».
WHATSAPP_PARENT_ACCESS_TEMPLATE_LANGUAGE=fr

# WATI (actif si WHATSAPP_PROVIDER=wati)
WATI_ENABLED=false
WATI_API_URL=https://live-mt-server.wati.io
WATI_API_KEY=
WATI_CHANNEL_NUMBER=
# Secret attendu sur le webhook WATI (Bearer, en-tête X-Wati-Webhook-Secret,
# paramètre ?token= ou signature HMAC X-Wati-Signature).
WATI_WEBHOOK_SECRET=
WATI_TIMEOUT=15
WATI_TEMPLATE_CACHE_TTL=300

# Noms des paramètres du modèle WATI, dans l'ordre des body_parameters.
# À renseigner depuis le modèle approuvé dans WATI (ou laisser vide pour
# la découverte automatique si le modèle est visible par la clé API).
WATI_EVALUATION_TEMPLATE=evaluation_wati_fr
WATI_EVALUATION_TEMPLATE_LANGUAGE=fr
WATI_EVALUATION_BODY_PARAMETERS=1,2,3,4,5
WATI_EVALUATION_URL_PARAMETER=6
WATI_ABSENCE_TEMPLATE=corischool_absence
WATI_ABSENCE_TEMPLATE_LANGUAGE=fr
WATI_ABSENCE_BODY_PARAMETERS=
WATI_ABSENCE_URL_PARAMETER=
WATI_LATENESS_TEMPLATE=template_retard
WATI_LATENESS_TEMPLATE_LANGUAGE=fr
WATI_LATENESS_BODY_PARAMETERS=
WATI_LATENESS_URL_PARAMETER=

# Accès parent : deux modèles distincts (le code est isolé du reste du message).
# verification_code_parent : {{1}} = code d'accès.
WATI_PARENT_ACCESS_CODE_TEMPLATE=verification_code_parent
WATI_PARENT_ACCESS_CODE_TEMPLATE_LANGUAGE=fr
WATI_PARENT_ACCESS_CODE_BODY_PARAMETERS=
WATI_PARENT_ACCESS_CODE_URL_PARAMETER=
# espace_parent : {{1}} = nom du parent, {{2}} = nom de l'établissement,
# paramètre du bouton URL = slug de l'établissement.
WATI_PARENT_ACCESS_SPACE_TEMPLATE=espace_parent
WATI_PARENT_ACCESS_SPACE_TEMPLATE_LANGUAGE=fr
WATI_PARENT_ACCESS_SPACE_BODY_PARAMETERS=
WATI_PARENT_ACCESS_SPACE_URL_PARAMETER=

# Web Push (PWA). WEBPUSH_PROVIDER=log journalise sans envoi réel.
# Passer à "minishlink" après avoir généré les clés :
#   php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
WEBPUSH_PROVIDER=log
VAPID_SUBJECT="mailto:support@coriyase.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Service clientèle : numéro WhatsApp affiché sur le bouton flottant.
# Format international sans espace (ex. +2250700000000). Vide = bouton masqué.
CORI_SUPPORT_WHATSAPP=
CORI_SUPPORT_EMAIL=support@coriyase.com
CORI_SUPPORT_WHATSAPP_MESSAGE="Bonjour, je souhaite entrer en contact avec le service clientèle de CoriSchool."

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
AUTH_GOOGLE_ONLY=false
GOOGLE_REAUTH_SECONDS=300
