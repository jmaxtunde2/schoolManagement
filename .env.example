APP_NAME="Gestion des Notes"
APP_ENV=local
APP_KEY=
# En production : APP_DEBUG=false (ne jamais exposer les traces de pile).
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En production (HTTPS), laisser la valeur par défaut : le cookie de session
# est alors automatiquement marqué « Secure ». Ne définir à true que si
# APP_ENV n'est pas « production ».
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# log pour le développement, esms_africa pour eSMS Africa, whatsapp pour Meta WhatsApp Cloud API
SMS_PROVIDER=log
SMS_API_URL=https://sms.esmsafrica.io
ESMS_TOKEN=
SMS_API_SECRET=
SMS_SENDER_ID=
# Indicatif par défaut (normalisation E.164 avant envoi WhatsApp)
SMS_COUNTRY_CODE=228

# Meta WhatsApp Business Cloud API (actif si SMS_PROVIDER=whatsapp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0

# Web Push (PWA). WEBPUSH_PROVIDER=log journalise sans envoi réel.
# Passer à "minishlink" après avoir généré les clés :
#   php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
WEBPUSH_PROVIDER=log
VAPID_SUBJECT="mailto:support@coriyase.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Service clientèle : numéro WhatsApp affiché sur le bouton flottant.
# Format international sans espace (ex. +2250700000000). Vide = bouton masqué.
CORI_SUPPORT_WHATSAPP=
CORI_SUPPORT_WHATSAPP_MESSAGE="Bonjour, je souhaite entrer en contact avec le service clientèle de CoriSchool."

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
AUTH_GOOGLE_ONLY=false
GOOGLE_REAUTH_SECONDS=300
